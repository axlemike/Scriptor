<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GUI.MainWindow"
        Width="1240"
        Height="820"
        Background="#1E1E1E"
        Foreground="#D4D4D4"
        Icon="avares://GUI/Assets/Scriptor_Icon_Pack/Scriptor.ico"
        Title="Scriptor GUI">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="BorderBrush" Value="#3F3F46" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#D4D4D4" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#3E3E42" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#252526" />
      <Setter Property="Foreground" Value="#D4D4D4" />
      <Setter Property="BorderBrush" Value="#3F3F46" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TreeView">
      <Setter Property="Background" Value="#252526" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,6,320,Auto" ColumnDefinitions="*">
    <Grid Grid.Row="0" RowDefinitions="Auto,Auto">
      <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ReloadButton" Content="Reload Scripts" />
          <Button x:Name="RunButton" Content="Run Selected" />
          <Button x:Name="NewPlaylistButton" Content="New Playlist" />
          <Button x:Name="EditPlaylistsButton" Content="Edit Playlists" />
          <Button x:Name="GenerateProjectButton" Content="Generate Project" />
          <Button x:Name="SettingsButton" Content="Settings" />
        </StackPanel>
      </Border>

      <Border x:Name="CompilationWarningBanner"
              Grid.Row="1"
              IsVisible="False"
              Background="#5C1F24"
              BorderBrush="#F44747"
              BorderThickness="0,0,0,1"
              Padding="8,6">
        <TextBlock x:Name="CompilationWarningBannerText"
                   Foreground="#FFFFFF"
                   TextWrapping="Wrap" />
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="360,Auto,*" Margin="10">
      <Border Grid.Column="0" Background="#252526" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="8" Padding="10" Margin="0,0,6,0">
        <Grid RowDefinitions="*,Auto,120">
          <Grid Grid.Row="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Operations" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TreeView Grid.Row="1" x:Name="CollectionsTree" DoubleTapped="CommandTreeItem_DoubleTapped">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal"
                              Spacing="6"
                              DragDrop.AllowDrop="True"
                              PointerPressed="PlaylistTreeItem_PointerPressed"
                              PointerMoved="PlaylistTreeItem_PointerMoved"
                              PointerReleased="PlaylistTreeItem_PointerReleased"
                              DragDrop.DragOver="PlaylistTreeItem_DragOver"
                              DragDrop.Drop="PlaylistTreeItem_Drop">
                    <Image Width="16"
                           Height="16"
                           Source="{Binding Icon}"
                           IsVisible="{Binding HasIcon}" />
                    <TextBlock Text="{Binding Name}"
                               ToolTip.Tip="{Binding Description}" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Grid>

          <TextBlock Grid.Row="1" Text="Collection Description" FontWeight="SemiBold" Margin="0,8,0,6" />
          <Border Grid.Row="2" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="6" Padding="8" Background="#1E1E1E">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="CollectionDescription" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#007ACC"
                    ShowsPreview="False"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" />

      <Border Grid.Column="2" Background="#252526" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="8" Padding="10" Margin="6,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Text="Routine Configuration" FontSize="16" FontWeight="SemiBold" />
          <Border Grid.Row="1" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="6" Padding="8" Margin="0,8,0,8" Background="#1E1E1E">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ParameterPanel" />
            </ScrollViewer>
          </Border>
          <Border Grid.Row="2" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="6" Padding="8" Height="120" Margin="0,0,0,8" Background="#1E1E1E">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="RoutineDescription" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="RunSelectedButton" Content="Run" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <GridSplitter Grid.Row="3"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="#007ACC"
                  ShowsPreview="False"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext" />

    <Border Grid.Row="4" Background="#252526" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="8" Padding="10" Margin="10,0,10,10">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Text="Run Log" FontSize="16" FontWeight="SemiBold" />
          <Button Grid.Column="1" x:Name="CopyRunLogButton" Content="Copy Run Log" Padding="8,4" />
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <Border Grid.Row="0" BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="4" Padding="6" Background="#1E1E1E">
            <Grid ColumnDefinitions="26,*,120,120">
              <TextBlock Grid.Column="0" Text="" />
              <TextBlock Grid.Column="1" Text="Details" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="Time" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </Grid>
          </Border>
          <ScrollViewer x:Name="RunLogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
            <ScrollViewer.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy Run Log" Click="CopyRunLogButton_Click" />
                <MenuItem Header="Clear Run Log" Click="ClearRunLogMenuItem_Click" />
              </ContextMenu>
            </ScrollViewer.ContextMenu>
            <StackPanel x:Name="RunLogRowsPanel" Spacing="4" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="5" Background="#2D2D30" BorderThickness="1" BorderBrush="#3F3F46" Padding="6" Margin="10,0,10,10" Height="34" CornerRadius="6">
      <TextBlock x:Name="ScriptPathStatus" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
